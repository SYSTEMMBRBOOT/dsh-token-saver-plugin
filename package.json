{
  "name": "dsh-token-saver-plugin",
  "version": "1.0.2",
  "description": "Deterministic token reduction: clamps oversized tool results before they enter the conversation, and optionally hides unused tools.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SYSTEMMBRBOOT/dsh-token-saver-plugin.git"
  },
  "homepage": "https://github.com/SYSTEMMBRBOOT/dsh-token-saver-plugin#readme",
  "bugs": {
    "url": "https://github.com/SYSTEMMBRBOOT/dsh-token-saver-plugin/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "bundle",
    "plugin",
    "tokens",
    "context"
  ],
  "license": "MIT"
}
